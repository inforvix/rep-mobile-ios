<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Pontovix Colaborador</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>rep_p_mobile</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- O backend de produção ainda é http:// (sem TLS): exceção restrita ao
	     domínio, aceitável na review da App Store. A entrada localhost cobre o
	     desenvolvimento local. Quando o servidor tiver TLS, remover o bloco. -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSExceptionDomains</key>
			<dict>
				<key>repvixbackend.inforvix.net.br</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
					<key>NSIncludesSubdomains</key>
					<true/>
				</dict>
				<key>localhost</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
				</dict>
			</dict>
		</dict>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Sua localização é usada para registrar o local onde a marcação de ponto foi realizada.</string>
		<!-- iOS 14+: o usuário pode liberar só a localização aproximada. A chave
		     "MarcacaoPonto" é o purposeKey usado em requestTemporaryFullAccuracy
		     (tela_home.dart) para pedir a precisa no momento da marcação. -->
		<key>NSLocationTemporaryUsageDescriptionDictionary</key>
		<dict>
			<key>MarcacaoPonto</key>
			<string>A localização precisa é necessária para registrar corretamente o local da marcação de ponto.</string>
		</dict>
		<key>NSCameraUsageDescription</key>
		<string>A câmera é usada para capturar sua foto no registro de ponto facial.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Este aplicativo não grava áudio. A permissão é exigida pelo componente de câmera do sistema.</string>
		<!-- Exigida pela App Store (erro 90683): o file_picker referencia APIs de
		     galeria no binário mesmo sem uso ativo no app. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>A galeria pode ser usada para anexar imagens em justificativas de marcação.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>FlutterSceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
